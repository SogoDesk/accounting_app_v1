PORT=5050
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=postgres
DB_PASSWORD=your_password_here
JWT_SECRET=your_super_secret_jwt_key_change_in_production
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# FX rate feed (services/currency/rateService.js). Uses exchangerate-api.com (v6):
# get a free key at https://app.exchangerate-api.com/ . Without it the daily-rate
# job fails loudly instead of writing nothing.
EXCHANGE_RATE_API_KEY=
# Optional: override the rate provider base URL (default exchangerate-api.com v6).
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
# Enable the monthly GL close scheduler (services/gl/closeScheduler.js).
GL_CLOSE_SCHEDULER=false


PUBLIC_BASE_URL=http://localhost:5050
# Email delivery. console = write .eml files to storage/outbox instead of sending.
MAIL_DRIVER=console
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
