# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build artifacts
dist/
frontend/dist/

# Runtime uploads and temp files
backend/uploads/*
!backend/uploads/.gitkeep

# Uploaded documents / attachments (may contain client data — never commit)
backend/storage/*
!backend/storage/.gitkeep

# One-off local data imports (may contain real financial data)
backend/utils/expenses_import_data.json

# Local editor / agent tooling
.claude/

# Vite cache
frontend/node_modules/.vite/

# Local design notes / documentation
docs/
